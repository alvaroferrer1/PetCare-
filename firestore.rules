rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if the user is accessing their own data
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isOwnerOrShared(resourceData) {
      return isAuthenticated() && (
        request.auth.uid == resourceData.userId || 
        (resourceData.keys().hasAll(['sharedEmails']) && request.auth.token.email in resourceData.sharedEmails)
      );
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /pets/{petId} {
      allow read: if isOwnerOrShared(resource.data);
      allow create: if isOwnerOrShared(request.resource.data);
      allow update, delete: if isOwnerOrShared(resource.data);
    }

    match /care_events/{eventId} {
      allow read: if isOwnerOrShared(resource.data);
      allow create: if isOwnerOrShared(request.resource.data);
      allow update, delete: if isOwnerOrShared(resource.data);
    }

    match /health_notes/{noteId} {
      allow read: if isOwnerOrShared(resource.data);
      allow create: if isOwnerOrShared(request.resource.data);
      allow update, delete: if isOwnerOrShared(resource.data);
    }

    match /weight_logs/{logId} {
      allow read: if isOwnerOrShared(resource.data);
      allow create: if isOwnerOrShared(request.resource.data);
      allow update, delete: if isOwnerOrShared(resource.data);
    }
    
    match /vet_contacts/{contactId} {
      allow read: if isOwnerOrShared(resource.data);
      allow create: if isOwnerOrShared(request.resource.data);
      allow update, delete: if isOwnerOrShared(resource.data);
    }
  }
}
